HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-spike
# Reasoner (OpenAI-compatible chat API). LLM_BACKEND=dev-stub is DEVELOPMENT ONLY (not an LLM).
LLM_BACKEND=llm
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Memory: hindsight (default) | dev (DEV-FALLBACK-NOT-HINDSIGHT, development only)
MEMORY_BACKEND=hindsight
